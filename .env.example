# ==========================================
# ResumeIQ - Environment Configuration Template
# Copy this file to .env and customize your local values:
# cp .env.example .env
# ==========================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME=ResumeIQ
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000

# Google Gemini API Key (Will be provided in final integration)
GEMINI_API_KEY=

# Embedding Model Identifier (Hugging Face / Sentence-Transformers)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

